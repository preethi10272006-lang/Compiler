%{
#include<stdio.h>
#include<string.h>
%}

%%
https?:\/\/[^\"\t\n]+ {
    printf("URL: %s\n", yytext);
}

href=\"[^\"]+\" {
    int len = strlen(yytext);
    int i;
    printf("URL: ");
    /* href=" (6 chars) thavirthu, kadaisi " munnadi varai print panna */
    for(i = 6; i < len - 1; i++) {
        printf("%c", yytext[i]);
    }
    printf("\n");
}

.|\n {
    /* Matha characters matrum newlines-ah ignore panna */
}
%%

int yywrap() {
    return 1;
}

int main() {
    printf("Enter HTML:\n");
    yylex(); // yytext() ku bathula yylex()
    return 0;
}
